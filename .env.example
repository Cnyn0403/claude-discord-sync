# Copy to ~/.claude/channels/discord-sync/.env and keep it private (chmod 600).
# Only DISCORD_BOT_TOKEN is read from this file; every other setting lives in
# config.json (see config.example.json).
DISCORD_BOT_TOKEN=

# These are read from the process environment, not from this file. Set them in
# your shell (or the systemd unit) if you need them:
#   DISCORD_SYNC_ASK_TIMEOUT=600     seconds a question/plan waits on Discord (set where you run ccd)
#   DISCORD_SYNC_STATE_DIR=...       state folder, default ~/.claude/channels/discord-sync
#   CLAUDE_CONFIG_DIR=...            Claude Code config folder, default ~/.claude
