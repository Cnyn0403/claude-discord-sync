# systemd user unit. Adjust the two paths if Bun or this repo live elsewhere
# (%h is your home directory).
[Unit]
Description=Claude Code <-> Discord session sync daemon
After=network-online.target

[Service]
ExecStart=%h/.bun/bin/bun %h/claude-discord-sync/src/daemon.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
